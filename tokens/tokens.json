{
  "$description": "Design tokens — single source of truth. src/tokens.css mirrors these values as CSS custom properties. Brand & status colors use Apple HIG system colors as the 500 step.",
  "color": {
    "gray": {
      "0": "#ffffff",
      "50": "#f8f9fb",
      "100": "#f1f3f6",
      "200": "#e4e7ec",
      "300": "#cfd4dc",
      "400": "#98a1b0",
      "500": "#6b7385",
      "600": "#4b5263",
      "700": "#353b48",
      "800": "#20242d",
      "900": "#14171d",
      "950": "#0b0d11"
    },
    "brand": {
      "$source": "Apple HIG systemBlue",
      "50": "#ebf4ff",
      "100": "#d6eaff",
      "200": "#add4ff",
      "300": "#7abaff",
      "400": "#3d9aff",
      "500": "#007aff",
      "600": "#0069db",
      "700": "#0055b2",
      "800": "#00428a",
      "900": "#003166",
      "dark": "#0a84ff"
    },
    "green": {
      "$source": "Apple HIG systemGreen",
      "50": "#effbf2",
      "100": "#dff6e4",
      "200": "#beedca",
      "300": "#95e2a9",
      "400": "#65d481",
      "500": "#34c759",
      "600": "#2dab4d",
      "700": "#248b3e",
      "800": "#1c6b30",
      "900": "#155024",
      "dark": "#30d158"
    },
    "orange": {
      "$source": "Apple HIG systemOrange",
      "50": "#fff7eb",
      "100": "#ffeed6",
      "200": "#ffddad",
      "300": "#ffc87a",
      "400": "#ffae3d",
      "500": "#ff9500",
      "600": "#db8000",
      "700": "#b26800",
      "800": "#8a5000",
      "900": "#663c00",
      "dark": "#ff9f0a"
    },
    "red": {
      "$source": "Apple HIG systemRed",
      "50": "#ffefee",
      "100": "#ffe0de",
      "200": "#ffc0bd",
      "300": "#ff9993",
      "400": "#ff6a62",
      "500": "#ff3b30",
      "600": "#db3329",
      "700": "#b22922",
      "800": "#8a201a",
      "900": "#661813",
      "dark": "#ff453a"
    },
    "cyan": {
      "$source": "Apple HIG systemCyan",
      "50": "#eff8fd",
      "100": "#def2fb",
      "200": "#bde5f7",
      "300": "#94d4f2",
      "400": "#63c1ec",
      "500": "#32ade6",
      "600": "#2b95c6",
      "700": "#2379a1",
      "800": "#1b5d7c",
      "900": "#14455c",
      "dark": "#64d2ff"
    }
  },
  "font": {
    "family": {
      "sans": "Pretendard, -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Segoe UI', Roboto, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "size": {
      "xs": "12px",
      "sm": "14px",
      "md": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px",
      "4xl": "36px",
      "5xl": "48px"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.25,
      "snug": 1.4,
      "normal": 1.6
    }
  },
  "space": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px"
  },
  "radius": {
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "shadow": {
    "xs": "0 1px 2px rgb(16 24 40 / 0.06)",
    "sm": "0 1px 3px rgb(16 24 40 / 0.08), 0 1px 2px rgb(16 24 40 / 0.04)",
    "md": "0 4px 12px -2px rgb(16 24 40 / 0.10), 0 2px 4px -2px rgb(16 24 40 / 0.06)",
    "lg": "0 12px 24px -4px rgb(16 24 40 / 0.12), 0 4px 8px -4px rgb(16 24 40 / 0.06)",
    "xl": "0 24px 48px -12px rgb(16 24 40 / 0.22)"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "normal": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.3, 0, 0, 1.3)"
    }
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
  "zIndex": {
    "dropdown": 1000,
    "sticky": 1100,
    "overlay": 1300,
    "modal": 1400,
    "toast": 1500,
    "tooltip": 1600
  }
}
